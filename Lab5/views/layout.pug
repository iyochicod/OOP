doctype html
html(lang="uk")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    block title
      title To-Do List (Express + Pug)
    style.
      body { font-family: Arial, sans-serif; max-width: 720px; margin: 40px auto; padding: 0 20px; color: #222; }
      h1 { color: #1a365d; border-bottom: 2px solid #cbd5e0; padding-bottom: 8px; }
      ul { list-style: none; padding: 0; }
      li { padding: 10px 14px; margin-bottom: 8px; border: 1px solid #e2e8f0; border-radius: 6px; background: #f8fafc; }
      .completed { text-decoration: line-through; color: #718096; }
      .badge { font-size: 0.85em; font-weight: bold; color: #2f855a; margin-left: 8px; }
  body
    header
      h1 Менеджер завдань (To-Do List)
    main
      block content
    footer
      hr
      p Практична робота № 5 — Express.js та Pug
